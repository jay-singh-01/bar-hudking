# Copy to .env.local. EVERYTHING here is optional — the app runs without any of it.

# --- Accounts & cross-device sync (see README "Optional: accounts & sync") ---
# Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Custom map tiles (defaults to OpenStreetMap, darkened) ---
# e.g. https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}{r}.png
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# --- Data pipeline only (scripts/data/fetch-searchapi.ts), never shipped ---
# https://www.searchapi.io/ — each query costs 1 credit.
SEARCHAPI_KEY=
