# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for the manual seed script (scripts/seed-places.ts), never
# used by the deployed app. Get a key from https://www.searchapi.io/
SEARCHAPI_KEY=

# Only needed for the manual seed script. This is the SERVICE ROLE key
# (Supabase dashboard -> Project Settings -> API -> service_role), NOT the
# anon key — it bypasses RLS, so it must never be committed or shipped to
# the frontend. See scripts/README.md.
SUPABASE_SERVICE_ROLE_KEY=
